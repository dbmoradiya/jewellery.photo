# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jewellery_photo"
# JWT secret - REQUIRED in production, set a long random value
JWT_SECRET="change-me-to-a-long-random-string"
# Bootstrap admin (created by seed if missing)
# Admin bootstrap is SKIPPED unless both are set (no default credentials exist)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Free credits granted on signup
FREE_CREDITS="2"
# Upload/storage dir
UPLOAD_DIR="./data"
# Optional: real AI provider (overrides DB settings when set)
# AI_PROVIDER="gemini"
# AI_API_KEY=""
# AI_MODEL="gemini-2.0-flash-preview-image-generation"
# Public port
PORT="8081"
